# Copy to .env and fill in. Never commit the real .env to git.

# ── Public-facing ──────────────────────────────────────────────────────────
# DNS A record for this host. Caddy will request a Let's Encrypt cert for it.
PUBLIC_DOMAIN=crashsafe.example.com
LETSENCRYPT_EMAIL=ops@example.com

# The single IP allowed to reach the dashboard. Use the operator's static IP
# or your VPN egress. Multiple IPs: separate with spaces in the Caddyfile
# matcher AND with commas in OPENINC_MONGO_BACKUP_ALLOWED_IPS.
# CIDR is supported on both sides (e.g. 203.0.113.0/24).
ALLOWED_CLIENT_IP=203.0.113.42

# ── CrashSafe dashboard auth ──────────────────────────────────────────────
# Username is harmless to leak. Password should be ≥ 20 chars, generated:
#   openssl rand -base64 24
ADMIN_USER=ops
ADMIN_PASSWORD=replace-with-openssl-rand-base64-24

# ── MongoDB ───────────────────────────────────────────────────────────────
# Same generation rule for the password. mongodb is internal-only here, but
# a strong password is still a good last line of defense if the docker
# network is ever bridged.
MONGO_USER=admin
MONGO_PASSWORD=replace-with-openssl-rand-base64-24

# ── Application ───────────────────────────────────────────────────────────
DB_DATA=owdata
DB_PARSE=parse
