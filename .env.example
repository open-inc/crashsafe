# MongoDB connection string (no database name — DBs are specified separately below)
OPENINC_MONGO_BACKUP_URI=mongodb://localhost:27017

# Directory where backups are stored
OPENINC_MONGO_BACKUP_DIR=./backups

# Cron schedule for automatic backups (default: every hour)
OPENINC_MONGO_BACKUP_CRON=0 * * * *

# --- Database Names ---
# Name of the sensor/data database to back up (omit or leave empty to skip)
OPENINC_MONGO_BACKUP_DB_DATA=owdata

# Name of the Parse server database to back up (omit or leave empty to skip)
OPENINC_MONGO_BACKUP_DB_PARSE=parse

# --- Sensor DB Options ---
# Prefix used to identify sensor collections (default: sensors---)
OPENINC_MONGO_BACKUP_COLLECTION_PREFIX=sensors---

# Name of the config collection that is always fully backed up (default: config)
OPENINC_MONGO_BACKUP_SENSOR_CONFIG_COLLECTION=config

# --- Change Detection Options ---
# Field name used for change detection (default: updatedAt)
OPENINC_MONGO_BACKUP_UPDATED_AT_FIELD=updatedAt

# --- Append-Only Mode (per database) ---
# Skips per-collection ID enumeration and delete detection on incremental backups.
# Massively faster for high-volume append-only workloads (e.g. sensor streams that
# only ever insert) at the cost of NOT capturing deletions — a deleted doc would
# stay in the backup chain and resurrect on restore.
# The data DB's config collection is exempt: it always keeps full delete tracking
# regardless of this setting.
# Default: false (full delete tracking, current behaviour). Set to "true" to enable.
# OPENINC_MONGO_BACKUP_APPEND_ONLY_DATA=false
# OPENINC_MONGO_BACKUP_APPEND_ONLY_PARSE=false

# --- Throttling for shared / single-node Mongo deployments ---
# Pause between collections during a backup, in milliseconds. Applies ONLY
# after collections where mongodump actually ran (i.e. that had changes
# since the last backup) — collections without changes don't trigger the
# pause, so total time scales with active collections, not total count.
# This makes the pause feasible even on 25 000-collection deployments
# where only a fraction change per run. Raise on a single mongod that
# also serves an application; WiredTiger gets time to evict and checkpoint.
# Default: 300. Typical "polite" values: 1000-5000.
# OPENINC_MONGO_BACKUP_COLLECTION_PAUSE_MS=300

# Run mongodump at low CPU + IO priority (Linux only).
# When true, mongodump is spawned via `nice -n 19 ionice -c 3 mongodump …`,
# so the kernel only grants it idle slices — the live workload always wins
# under contention. Backups take longer, but the host stays responsive.
# Default: false. Enabling this on macOS will fail at spawn time (no ionice).
# OPENINC_MONGO_BACKUP_NICE_BACKUP=false

# --- UI Options ---
# Port for the Web Dashboard (default: 3000)
OPENINC_MONGO_BACKUP_UI_PORT=3000

# Optional HTTP Basic Auth for the dashboard.
# Set BOTH to enable auth; leave BOTH unset to disable. Setting only one is rejected at startup.
# OPENINC_MONGO_BACKUP_AUTH_USER=admin
# OPENINC_MONGO_BACKUP_AUTH_PASSWORD=changeme
